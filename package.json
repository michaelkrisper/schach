{
  "name": "schachfoto",
  "version": "1.0.0",
  "private": true,
  "description": "Photograph a chess board, recognise the position and see the best moves. PWA with a small Node backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelkrisper/schach.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "node --test 'tests/*.test.js'",
    "check": "npm run lint && npm test",
    "start": "node server/node.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  },
  "engines": {
    "node": ">=26"
  }
}
